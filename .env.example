# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are public: they ship to the browser. Everything else is server-only.

# Supabase project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Public by design: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. Server-only: acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=

# Clerk publishable key. Public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key. Server-only.
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook. Server-only.
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI API key for chat and embeddings. Server-only.
OPENAI_API_KEY=

# Arcjet key for rate limiting and prompt-injection checks. Server-only.
ARCJET_KEY=

# PostHog project key. Public.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host. Public.
NEXT_PUBLIC_POSTHOG_HOST=

# Base URL of this app. Public.
NEXT_PUBLIC_APP_URL=

# Public key of the widget shown on our own landing page. Server-only: read at request time, set per environment.
LANDING_WIDGET_KEY=
